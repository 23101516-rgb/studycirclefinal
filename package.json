{
  "name": "studycircle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:server\" \"npm:client\"",
    "client": "vite",
    "server": "node --watch server/index.js",
    "build": "vite build",
    "start": "npm run build && node server/index.js",
